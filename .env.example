# --- required ---
GEMINI_API_KEY=            # https://aistudio.google.com/apikey (Live agent, spine reading, checker)
                                           # also enable the Books API on the same Google Cloud project
SERPER_API_KEY=            # https://serper.dev  Google Shopping prices (2,500 free queries)
DREX_API_KEY=                # https://drex.nace.ai  decision model (identity / listing match / appraisal)
DREX_BASE_URL=https://drex.nace.ai
DREX_MODEL=drex-latest
# Modal (GPU reconstruction): `uv run modal token new` once; credentials live in ~/.modal.toml

# --- recommended / optional ---
EBAY_CLIENT_ID=                            # https://developer.ebay.com production keyset (used-book prices)
EBAY_CLIENT_SECRET=
GOOGLE_BOOKS_API_KEY=                      # optional; defaults to GEMINI_API_KEY
HF_TOKEN=                        # optional: free HF Spaces for evaluation scripts (SAM 3 cross-check)

# --- spines: SAM 3.1 on the Meta API (empty key -> spines from the vision model) ---
META_API_KEY=
SPINE_SOURCE=sam
SAM_CONCURRENCY=8
SAM_COST_PER_IMAGE=0.0

# --- models (current IDs: https://ai.google.dev/gemini-api/docs/models) ---
LIVE_MODEL=gemini-3.8-live
VISION_MODEL=gemini-3.8-flash
VISION_FALLBACK_MODEL=gemini-3.5-flash-lite # on 503 "high demand" (faster, slightly less accurate)
VISION_THINKING=low
CHECKER_MODEL=gemini-pro-latest            # a different model audits identities
LIVE_VOICE=Kore
RECON_MODEL=mapanything                    # mapanything | vggt (both deployed on Modal)

# --- locale ---
DEFAULT_COUNTRY=IN                         # IN | US | GB (agent confirms with the user)
COMPARISON_COUNTRY=US                      # second market for the 10-book locale check

# --- calibration (measure, don't guess) ---
MARKER_SIZE_CM=15.0                        # ruler-measured side of the printed black square
BLUR_MIN=60                                # Laplacian variance at 640 px; raise if blurry frames pass
GLARE_MAX=0.06
MOTION_MAX=28
NOVELTY_MIN=10
MAX_RECON_FRAMES=150
LIVE_READ_CONCURRENCY=8
CONF_IDENTIFIED=0.75                       # DREX P(same work) for a confident identification
LISTING_MATCH_MIN=0.8                      # DREX P(listing is this book/item)
APPRAISAL_MIN=0.5
